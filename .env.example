# ==============================================================================
# Bale Messenger Bot Configuration
# ==============================================================================
# Bot token obtained from @botfather in Bale (format: 123456789:abcdef...)
BALE_BOT_TOKEN=your_bale_bot_token_here

# Target Bale chat, group, or channel ID (e.g., 123456789 or -100123456789)
BALE_CHAT_ID=your_target_chat_id_here

# Optional: Separate admin chat ID for cookie-expiry (401/403) alerts.
# Defaults to BALE_CHAT_ID if left empty.
BALE_ADMIN_CHAT_ID=

# ==============================================================================
# X (Twitter) Cookie Authentication (@dontcallmeela)
# ==============================================================================
# Export from x.com browser DevTools -> Application -> Cookies -> https://x.com
X_AUTH_TOKEN=your_x_auth_token_cookie_here
X_CT0=your_x_ct0_cookie_here
X_TARGET_USERNAME=dontcallmeela

# ==============================================================================
# State Persistence (PostgreSQL Primary, SQLite Fallback)
# ==============================================================================
# PostgreSQL connection string (e.g. Supabase / Neon free tier).
# Leave empty to use local SQLite at SQLITE_PATH.
DATABASE_URL=
SQLITE_PATH=data/state.db

# ==============================================================================
# Polling, Media & Server Settings
# ==============================================================================
POLL_INTERVAL_SECONDS=180
POLL_JITTER_SECONDS=15
COLD_START_SEED_COUNT=8
TIMELINE_FETCH_COUNT=25
MAX_VIDEO_SIZE_MB=45
TEMP_MEDIA_DIR=/tmp/x_bale_media
LOG_LEVEL=INFO
PORT=8000
